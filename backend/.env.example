# GapLens Backend Environment Variables
# Copy this file to .env and fill in your API keys

# App
APP_NAME=GapLens API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=sqlite+aiosqlite:///./gaplens.db

# Tavily API (required for web search)
# Get from https://tavily.com
TAVILY_API_KEY=

# Jina AI (optional, for better extraction)
# Get from https://jina.ai
JINA_API_KEY=

# Google Gemini (required for LLM reasoning)
# Get from https://aistudio.google.com
GEMINI_API_KEY=

# Groq (fallback LLM, optional but recommended)
# Get from https://console.groq.com
GROQ_API_KEY=

# Pipeline settings
MAX_SOURCES_PER_SESSION=15
MAX_DIMENSIONS=10
SEARCH_DEPTH=advanced
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_DIM=1024

# SSE
SSE_RETRY_MS=3000