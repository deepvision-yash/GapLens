# GapLens Backend Environment Variables
# Copy this file to .env and fill in your API keys

# App
APP_NAME=GapLens API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
SEARCH_PROVIDER=jina

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=sqlite+aiosqlite:///./gaplens.db

# Search API (choose Tavily or Jina Search; Jina Search requires JINA_API_KEY)
# Get from https://tavily.com
TAVILY_API_KEY=

# Jina Reader works without a key at lower limits. Jina Search requires a key.
# Get from https://jina.ai
JINA_API_KEY=

# Google Gemini (primary LLM when LLM_PROVIDER=gemini)
# Get from https://aistudio.google.com
GEMINI_API_KEY=

# Groq (fallback LLM, or primary when LLM_PROVIDER=groq)
# Get from https://console.groq.com
GROQ_API_KEY=

# Pipeline settings
# Research topic input guardrail uses the configured Gemini/Groq LLM provider.
# It checks relevance and unsafe instructions before any session is created.
MAX_SOURCES_PER_SESSION=10
MAX_DIMENSIONS=6
SEARCH_DEPTH=advanced
JINA_EMBEDDING_MODEL=jina-embeddings-v3
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_DIM=1024

# SSE
SSE_RETRY_MS=3000
